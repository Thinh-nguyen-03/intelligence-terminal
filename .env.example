# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string (find in Neon dashboard → Connection Details)
# Use the "pooled" connection string for the API server.
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# ── FRED API ──────────────────────────────────────────────────────────────────
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── API Server ───────────────────────────────────────────────────────────────
PORT=8080

# ── Internal Job Auth ─────────────────────────────────────────────────────────
# Secret token required to call /api/v1/internal/* endpoints.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=your_secret_token_here

# ── Frontend (apps/web/.env.local) ────────────────────────────────────────────
# URL of the running API server. For local dev, http://localhost:8080.
# For production (Cloud Run), use the deployed service URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
